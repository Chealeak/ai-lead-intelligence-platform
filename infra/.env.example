# Copy this file to infra/.env. Generate each secret independently, for example:
# openssl rand -hex 32
APP_SECRET=replace_with_random_32_byte_value
ADMIN_API_KEY=replace_with_random_32_byte_value
INTERNAL_SERVICE_SECRET=replace_with_random_32_byte_value
POSTGRES_DB=ai_platform
POSTGRES_USER=app
POSTGRES_PASSWORD=replace_with_random_database_password
OPENROUTER_API_KEY=your_openrouter_api_key
