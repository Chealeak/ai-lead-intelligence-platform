# Copy to services/backend/.env.local for non-Docker development.
APP_SECRET=generate_a_random_application_secret
ADMIN_API_KEY=generate_a_random_admin_api_key
INTERNAL_SERVICE_SECRET=use_the_same_random_service_secret_as_ai_orchestrator
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
OPENROUTER_API_KEY=your_openrouter_api_key
MAILER_DSN=null://null
MAILER_FROM=assistant@example.com
